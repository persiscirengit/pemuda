{
  "name": "pemuda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:spell": "cspell --no-progress \"**\" --config cspell.json",
    "check:guardrails": "tsx scripts/guardrails.ts",
